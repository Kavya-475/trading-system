# Runtime / per-deployment state — MUST stay untracked so the live cron's writes
# (holdings, logs, dated backups) don't block scheduler.py's `git pull` self-update.
# Tracking these is what froze the VM on stale code for weeks (audit 2026-06).
current_holdings.json
orders.log
scheduler.log
backups/

# paper_replay one-off holdings backup
current_holdings.json.prereplay.bak

# paper ledger (per-deployment state)
paper_state.json
